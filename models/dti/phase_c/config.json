{
  "type": "graph_dta",
  "drug_encoder": {
    "type": "chembert_encoder",
    "model_name": "DeepChem/ChemBERTa-77M-MTR",
    "hidden_dim": 384,
    "out_dim": 256,
    "max_length": 256,
    "pooling": "mean",
    "freeze_backbone": true,
    "dropout": 0.1
  },
  "target_encoder": {
    "type": "esm2_encoder",
    "model_name": "facebook/esm2_t12_35M_UR50D",
    "hidden_dim": 480,
    "out_dim": 256,
    "max_length": 1024,
    "pooling": "mean",
    "freeze_backbone": true,
    "gradient_checkpointing": false,
    "dropout": 0.1
  },
  "fusion": {
    "type": "cross_attention_fusion",
    "drug_dim": 256,
    "target_dim": 256,
    "hidden_dim": 256,
    "num_heads": 4,
    "dropout": 0.1,
    "out_dim": 1
  },
  "use_domain_adaptation": false
}